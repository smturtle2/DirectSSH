{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DirectSSH",
  "version": "0.1.0",
  "identifier": "dev.directssh.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DirectSSH",
        "width": 1024,
        "height": 700,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Standalone SSH terminal client"
  }
}
